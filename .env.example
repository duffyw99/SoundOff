# Copy to .env for local development. NEVER commit a real .env file.
# Every value below is a fake placeholder. In production, secrets come from
# Google Secret Manager and plain config from Cloud Run environment variables.

# ---- Server (server/) ----
NODE_ENV=development
PORT=8080

# Public URL of the app, used to build invite and recovery links
APP_BASE_URL=http://localhost:5173

# Google Cloud / Firestore
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Set this to use the local Firestore emulator (leave unset in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081

# YouTube Data API v3 key (server-side only; restrict the key to the YouTube Data API v3)
YOUTUBE_API_KEY=replace-me

# Secrets for token hashing and signing (generate with: openssl rand -base64 48)
TOKEN_HASH_PEPPER=replace-me-with-a-long-random-string
TOKEN_SIGNING_SECRET=replace-me-with-a-long-random-string

# Expected audience for Cloud Scheduler OIDC calls to /internal/tick
INTERNAL_TICK_AUDIENCE=http://localhost:8080
# Set to true ONLY in local dev to allow calling /internal/tick without OIDC
ALLOW_UNAUTHENTICATED_TICK=false

# ---- Web (web/) ----
# WARNING: anything prefixed VITE_ is bundled into the public client. No secrets here.
VITE_API_BASE_URL=http://localhost:8080
